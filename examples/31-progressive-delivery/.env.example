# Local development settings for `vp run dev:rollout`. Copy to .env; never commit .env.
# These are configuration, not secrets. This example has no secrets.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
PORT=8787

# Flags come from this file locally, read on every request. On Lambda they come from AppConfig.
FLAGS_FILE=flags/flags.json

# Share of requests (0 to 100) that this build answers with a 500. For practising a rollback.
FAULT_PERCENT=0
