# Local settings for `vp run dev:async`. Copy to .env; never commit .env.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
PORT=8787
NOTES_STORE=memory
UPLOADS_STORE=memory

# Signs the local development tokens and the local upload permits.
# Not an AWS secret, never deployed. Any string of 32 characters or more.
LOCAL_AUTH_SECRET=local-development-only-not-a-real-secret

# The in-memory queue that stands in for SQS. A failed message comes back
# after the visibility timeout, and is set aside after this many receives.
LOCAL_QUEUE_VISIBILITY_SECONDS=5
LOCAL_QUEUE_MAX_RECEIVE_COUNT=3
# true: every message is delivered twice, to watch a duplicate change nothing.
LOCAL_QUEUE_DUPLICATE=false
