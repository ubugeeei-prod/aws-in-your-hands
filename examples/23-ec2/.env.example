# Local settings for `vp run dev:ec2`. Copy to .env; never commit .env.
# These are configuration, not secrets. This example has no secrets.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
HOST=127.0.0.1
PORT=8787
# On the instance this is a file on the data volume. Here it is a file in this directory.
NOTES_FILE=.data/notes.json
