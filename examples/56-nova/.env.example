# Local development settings for `vp run dev:nova`. Copy to .env; never commit .env.
# These are configuration, not secrets. This example has no secrets.

# scripted: plays a canned answer over an in-memory bucket. No AWS call, no charge.
# bedrock: calls Amazon Bedrock and S3 with your own credentials. Every new description is billed.
NOVA_BACKEND=scripted

# With NOVA_BACKEND=scripted: described, refused, max-tokens, throttled-then-described
NOVA_SCRIPT=described

# A route checked on 2026-10-13. `vp run nova:catalog` lists the others.
DESCRIBE_MODEL_ID=jp.amazon.nova-2-lite-v1:0
AWS_REGION=ap-northeast-1

# With NOVA_BACKEND=bedrock: the MediaBucketName output of the AihNova stack.
# MEDIA_BUCKET=

MAX_OUTPUT_TOKENS=300
INFERENCE_TIMEOUT_MS=30000
LEASE_SECONDS=60
DESCRIPTION_LANGUAGE=ja
LOG_LEVEL=debug
STAGE=local
PORT=8856
