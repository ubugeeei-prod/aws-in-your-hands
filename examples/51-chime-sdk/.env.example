# Local settings for `vp run dev:calls:api`. Copy to .env; never commit .env.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
PORT=8787
NOTES_STORE=memory

# fake: a model of the meetings API inside the API process. No Chime call, no media.
# The development server accepts nothing else; chime is what the deployed function uses.
MEETINGS=fake

# Signs the local development tokens. Not an AWS secret, never deployed.
# Any string of 32 characters or more.
LOCAL_AUTH_SECRET=local-development-only-not-a-real-secret
