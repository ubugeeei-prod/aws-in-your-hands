# Local development settings for `vp run dev:ai`. Copy to .env; never commit .env.
# These are configuration, not secrets. This example has no secrets.

# fixture: replays a canned stream. No AWS call, no charge.
# bedrock: calls Amazon Bedrock with your own credentials. Every summary is billed.
AI_BACKEND=fixture

# With AI_BACKEND=fixture: complete, max-tokens, truncated, throttled-midstream, throttled-then-complete
AI_FIXTURE=complete

# An inference profile ID checked on 2026-10-11. See infra/lib/models.ts for the others.
BEDROCK_MODEL_ID=jp.amazon.nova-2-lite-v1:0
AWS_REGION=ap-northeast-1

MAX_OUTPUT_TOKENS=400
INFERENCE_TIMEOUT_MS=30000
LOG_LEVEL=debug
STAGE=local
PORT=8788
