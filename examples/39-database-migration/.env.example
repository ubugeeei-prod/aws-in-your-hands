# Read by `vp run dbmig:preflight`, `dbmig:verify`, and `dbmig:sequences` from the
# repository root's .env. Both databases are in private subnets: run those tasks
# from a machine inside the VPC. Never commit real connection strings.
SOURCE_DATABASE_URL=postgres://<user>:<password>@<source host>:5432/<database>?sslmode=require
TARGET_DATABASE_URL=postgres://<user>:<password>@<target host>:5432/<database>?sslmode=require
