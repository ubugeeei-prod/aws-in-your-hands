# Local development settings for `vp run dev:sql`. Copy to .env; never commit .env.
# These are configuration, not secrets. Aurora DSQL has no password to keep here.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
PORT=8787

# pglite: PostgreSQL inside this process, stored under PGLITE_DATA_DIR. No Docker, no AWS.
# dsql: a deployed Aurora DSQL cluster, reached with your own AWS credentials (billed).
NOTES_DB=pglite
PGLITE_DATA_DIR=.pglite

# Used when NOTES_DB=dsql. The endpoint is the ClusterEndpoint output of the AihSql stack.
# DSQL_ENDPOINT=xxxxxxxxxxxxxxxxxxxxxxxxxx.dsql.ap-northeast-1.on.aws
# `admin` on a laptop needs dsql:DbConnectAdmin. The Lambda function uses notes_api.
# DSQL_USER=admin
