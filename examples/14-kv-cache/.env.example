# Local development settings for `vp run dev:kv`. Copy to .env; never commit .env.
# These are configuration, not secrets.

LOG_LEVEL=debug
STAGE=local
PORT=8794

# 5 requests per minute per source address. `sliding` weighs in the previous minute.
RATE_LIMIT=5
RATE_WINDOW_SECONDS=60
RATE_ALGORITHM=fixed
# When the counter store fails: allow (stay available) or deny (stay strict).
RATE_ON_ERROR=allow

CACHE_TTL_SECONDS=30
# How slow the pretend source of truth is.
SOURCE_DELAY_MS=300

# memory: Maps in the process, gone on restart. No Docker, no AWS.
# dynamodb: needs TABLE_NAME, and DYNAMODB_ENDPOINT (DynamoDB Local) or AWS credentials (billed).
# valkey: needs VALKEY_URL, a Valkey on this machine.
KV_STORE=memory

# Used when KV_STORE=dynamodb. Started by `vp run kv:local:start`.
TABLE_NAME=aih-kv-local
DYNAMODB_ENDPOINT=http://localhost:8001

# Used when KV_STORE=valkey. Started by `vp run kv:local:start`.
VALKEY_URL=valkey://localhost:6390
