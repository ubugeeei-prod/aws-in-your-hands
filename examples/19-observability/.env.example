# Local development settings for `vp run dev:obs`. Copy to .env; never commit .env.
# These are configuration, not secrets.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
PORT=8787

# A Map in the process, gone on restart. No Docker, no AWS.
NOTES_STORE=memory

# Share of new traces the local tracer records, from 0 to 1.
# Try 0: the log lines keep their traceId, and no span is printed.
TRACE_SAMPLE_RATIO=1
