# Local development settings for `vp run dev:search`. Copy to .env; never commit .env.
# These are configuration, not secrets. This example has no secrets.

# local: notes and vectors in memory, a hashing embedder, a canned answer. No AWS call, no charge.
# aws:   DynamoDB, S3 Vectors and Amazon Bedrock with your own credentials. Billed.
SEARCH_BACKEND=local

# Used when SEARCH_BACKEND=aws. The first two are outputs of the AihSearch stack.
TABLE_NAME=
VECTOR_INDEX_ARN=
BEDROCK_MODEL_ID=jp.amazon.nova-2-lite-v1:0
AWS_REGION=ap-northeast-1

MAX_OUTPUT_TOKENS=400
INFERENCE_TIMEOUT_MS=30000
LOG_LEVEL=debug
STAGE=local
PORT=8827
