# Local development settings for `vp run dev:app:api`. Copy to .env; never commit .env.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
PORT=8787
NOTES_STORE=memory

# Local sign-in only. `vp run dev:app:api` signs and verifies development
# tokens with this value. It is not a Cognito secret and is never deployed:
# the Lambda entry point does not read it. Any string of 32 characters or more.
LOCAL_AUTH_SECRET=local-development-only-not-a-real-secret
