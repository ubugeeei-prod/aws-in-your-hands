# Local settings for `vp run dev:app:api`. Copy to .env; never commit .env.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
PORT=8787
NOTES_STORE=memory

# Signs the local development tokens. Not a Cognito secret, never deployed.
# Any string of 32 characters or more.
LOCAL_AUTH_SECRET=local-development-only-not-a-real-secret
