{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "notes"
      }
    },
    {
      "apiVersion": "eks.amazonaws.com/v1",
      "kind": "NodeClass",
      "metadata": {
        "name": "notes"
      },
      "spec": {
        "role": "AihEks-NodeRole-EXAMPLE",
        "subnetSelectorTerms": [
          {
            "tags": {
              "Name": "AihNetwork/Public1"
            }
          },
          {
            "tags": {
              "Name": "AihNetwork/Public2"
            }
          }
        ],
        "securityGroupSelectorTerms": [
          {
            "id": "sg-0123456789abcdef0"
          }
        ],
        "ephemeralStorage": {
          "size": "20Gi"
        },
        "advancedNetworking": {
          "associatePublicIPAddress": true
        }
      }
    },
    {
      "apiVersion": "karpenter.sh/v1",
      "kind": "NodePool",
      "metadata": {
        "name": "notes"
      },
      "spec": {
        "template": {
          "spec": {
            "nodeClassRef": {
              "group": "eks.amazonaws.com",
              "kind": "NodeClass",
              "name": "notes"
            },
            "requirements": [
              {
                "key": "kubernetes.io/arch",
                "operator": "In",
                "values": ["arm64"]
              },
              {
                "key": "karpenter.sh/capacity-type",
                "operator": "In",
                "values": ["on-demand"]
              },
              {
                "key": "node.kubernetes.io/instance-type",
                "operator": "In",
                "values": ["t4g.medium"]
              }
            ]
          }
        },
        "disruption": {
          "consolidationPolicy": "WhenEmptyOrUnderutilized",
          "consolidateAfter": "30s"
        },
        "limits": {
          "cpu": "8"
        }
      }
    },
    {
      "apiVersion": "eks.amazonaws.com/v1",
      "kind": "IngressClassParams",
      "metadata": {
        "name": "notes-alb"
      },
      "spec": {
        "scheme": "internet-facing",
        "subnets": {
          "matchTags": [
            {
              "key": "Name",
              "values": ["AihNetwork/Public1", "AihNetwork/Public2"]
            }
          ]
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "IngressClass",
      "metadata": {
        "name": "notes-alb"
      },
      "spec": {
        "controller": "eks.amazonaws.com/alb",
        "parameters": {
          "apiGroup": "eks.amazonaws.com",
          "kind": "IngressClassParams",
          "name": "notes-alb"
        }
      }
    }
  ]
}
