# Local development settings for `vp run dev:agentcore`. Copy to .env; never commit .env.

# The local server only plays transcripts: no AWS call, no charge.
AI_BACKEND=scripted

# One of chapter 36's transcripts (examples/36-bedrock/fixtures/transcripts).
AI_TRANSCRIPT=tool-then-answer

# An inference profile ID from chapter 36's src/models.ts.
BEDROCK_MODEL_ID=jp.amazon.nova-2-lite-v1:0

# Signs the local development tokens, as in chapter 06. Not a real secret, never deployed.
LOCAL_AUTH_SECRET=local-development-only-not-a-real-secret

LOG_LEVEL=debug
PORT=8850
