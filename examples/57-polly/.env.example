# Local development settings for `vp run dev:polly`. Copy to .env; never commit .env.
# These are configuration, not secrets. This example has no secrets.

# fake: a tone as long as the text would take to read. No AWS call, no charge.
# polly: calls Amazon Polly with your own credentials. Every character is billed.
SPEECH_BACKEND=fake

# With SPEECH_BACKEND=polly, the bucket that holds the audio (the stack's CacheBucketName).
# SPEECH_BUCKET=

AWS_REGION=ap-northeast-1
LOG_LEVEL=debug
STAGE=local
PORT=8857
