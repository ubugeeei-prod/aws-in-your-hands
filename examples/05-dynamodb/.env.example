# Local development settings for `vp run dev:notes`. Copy to .env; never commit .env.
# These are configuration, not secrets.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
PORT=8787

# Where notes are kept.
#   memory   - a Map inside the process. No Docker, no AWS. Gone when the process restarts.
#   dynamodb - a DynamoDB table. Needs TABLE_NAME, and either DYNAMODB_ENDPOINT
#              (DynamoDB Local) or AWS credentials (a real table, which is billed).
NOTES_STORE=memory

# Used when NOTES_STORE=dynamodb.
TABLE_NAME=aih-notes-local
# DynamoDB Local, started by `vp run db:local:start`. Remove this line to reach real AWS.
DYNAMODB_ENDPOINT=http://localhost:8000
