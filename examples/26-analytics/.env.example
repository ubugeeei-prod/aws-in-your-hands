# Local development settings for `vp run dev:analytics`. Copy to .env; never commit .env.
# These are configuration, not secrets.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=info
STAGE=local
PORT=8787

# A Map in the process, gone on restart. No Docker, no AWS.
NOTES_STORE=memory

# Where the local stand-in for Firehose writes its objects, and how long it buffers.
LAKE_DIR=dist/lake
LAKE_FLUSH_SECONDS=5
