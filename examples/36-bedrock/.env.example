# Local development settings for `vp run dev:bedrock`. Copy to .env; never commit .env.

# scripted: plays a hand-written transcript. No AWS call, no charge.
# bedrock: calls Amazon Bedrock with your own credentials. Every question is billed.
AI_BACKEND=scripted

# With AI_BACKEND=scripted: answer-direct, tool-then-answer, invented-tool, malformed-input,
# guardrail-blocked, cut-mid-tool-use, cut-mid-answer, throttled-then-answer, always-throttled,
# runaway-tools, injected
AI_TRANSCRIPT=tool-then-answer

# An inference profile ID from src/models.ts, checked on 2026-10-13.
BEDROCK_MODEL_ID=jp.amazon.nova-2-lite-v1:0
AWS_REGION=ap-northeast-1

MAX_OUTPUT_TOKENS=600
MAX_TURNS=4
MAX_TOTAL_TOKENS=20000
INFERENCE_TIMEOUT_MS=60000
# What one owner may spend in a UTC day, in millionths of a dollar. 500000 is USD 0.50.
DAILY_BUDGET_MICRO_USD=500000
PROMPT_CACHE=off

# Signs the local development tokens, as in chapter 06. Not a real secret, never deployed.
LOCAL_AUTH_SECRET=local-development-only-not-a-real-secret

LOG_LEVEL=debug
STAGE=local
PORT=8836
