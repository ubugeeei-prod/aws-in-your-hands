# Local settings for `vp run dev:ecs`. Copy to .env; never commit .env.
# These are configuration, not secrets. This example has no secrets.

# Browser origin allowed to call the API (the SPA dev server from chapter 03).
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
PORT=8080
# In the task definition this is the image tag, so a response says which build answered.
APP_VERSION=dev
