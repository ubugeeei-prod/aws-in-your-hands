# Local settings for the chapter 30 tasks. Copy to .env; never commit .env.
# These are configuration, not secrets.

# A table of its own in the same DynamoDB Local that chapter 05 starts with `vp run db:local:start`.
# `vp run modeling:db:migrate:local` creates it there, with its index and stream.
TABLE_NAME=aih-modeling-local
DYNAMODB_ENDPOINT=http://localhost:8000
