# Local settings for `vp run dev:uploads:api`. Copy to .env; never commit .env.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
STAGE=local
PORT=8787
NOTES_STORE=memory

# memory: images are kept in the API process and vanish when it restarts. No Docker, no AWS.
# The development server accepts nothing else; s3 is what the deployed function uses.
UPLOADS_STORE=memory

# Signs the local development tokens and the local upload permits.
# Not an AWS secret, never deployed. Any string of 32 characters or more.
LOCAL_AUTH_SECRET=local-development-only-not-a-real-secret
