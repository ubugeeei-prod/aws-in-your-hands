# Local development settings for `vp run dev:sec`. Copy to .env; never commit .env.
# These are configuration, not secrets. Locally the signing key is made up at
# startup and kept in memory, so there is no secret to put in this file.

LOG_LEVEL=debug
STAGE=local
PORT=8796

SECRET_SOURCE=memory

# How long an issued token is valid.
TOKEN_TTL_SECONDS=300
# How long a loaded key is used before asking the source again.
KEY_CACHE_SECONDS=300
# The shortest gap between reloads that unknown key versions may trigger.
KEY_REFRESH_MIN_SECONDS=30
