# Local development settings for `vp run dev:limits`. Copy to .env; never commit .env.
# These are configuration, not secrets.

ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=warn
STAGE=local
PORT=8787

# A Map in the process, gone on restart. No Docker, no AWS.
NOTES_STORE=memory

# The stand-in for the stage throttle: requests per second for everyone together, and the burst.
STAGE_RATE=10
STAGE_BURST=20
# One caller's share, per 10 seconds. Chapter 14's limiter with its counters in memory.
CALLER_LIMIT=50
