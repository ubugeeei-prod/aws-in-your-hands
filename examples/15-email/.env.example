# Local development settings for `vp run dev:mail`. Copy to .env; never commit .env.
# These are configuration, not secrets. This example has no secrets.

# local: mail goes to an in-memory outbox, records to a Map. No AWS, no charge.
# aws:   SES and DynamoDB. Only the deployed functions use it; the dev server refuses it.
MAIL_MODE=local

# The From address. In AWS it must belong to a verified SES identity.
FROM_ADDRESS=notes@example.com
# Links in the mail point here.
APP_ORIGIN=http://localhost:5173
# Days a "this notification was handled" record is kept.
RETENTION_DAYS=30

LOG_LEVEL=debug
STAGE=local
PORT=8787
