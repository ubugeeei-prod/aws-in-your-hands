# Copy to .env (ignored by git). Tasks that touch AWS load it with
# `node --env-file-if-exists=.env`. Nothing here is a secret, and no AWS
# credential belongs in this file: sign in with `aws login` instead.

# The only AWS account that deploy, publish, and destroy tasks may change.
# Tasks that change AWS refuse to run while this is unset or does not match
# the account of the credentials in use.
AIH_AWS_ACCOUNT_ID=

# Region for every example. The book assumes ap-northeast-1 unless a section
# says otherwise.
AIH_AWS_REGION=ap-northeast-1

# AWS CLI/SDK profile created by `aws login --profile aih`.
AWS_PROFILE=aih
